#!/usr/bin/env bash
# Runs the same checks as .github/workflows/ci.yaml before a commit is created.
# Enabled by the repo shell (shell.nix sets core.hooksPath). Skip once with
# `git commit --no-verify`.
set -euo pipefail

# Nothing to evaluate when the commit touches no Nix code.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '(\.nix|^flake\.lock)$'; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

step() {
  echo "pre-commit: $1"
  shift
  if ! "$@"; then
    echo "pre-commit: failed -- fix it, or skip with 'git commit --no-verify'" >&2
    exit 1
  fi
}

step "format (alejandra)" nix run nixpkgs#alejandra -- -q -c .
step "lint (deadnix)" nix run nixpkgs#deadnix -- -f
step "nix flake check" nix flake check --all-systems
# `nix flake check` does not evaluate darwinConfigurations, so do it by hand.
step "eval darwinConfigurations.macBook" \
  nix eval --raw .#darwinConfigurations.macBook.system.drvPath
